# --- Correo ---------------------------------------------------------------
# EMAIL_SERVICE es lo que manda. El preset de nodemailer resuelve host, puerto
# y modo TLS, y SOBREESCRIBE cualquier SMTP_HOST/SMTP_PORT que se le pase.
# "gmail" -> smtp.gmail.com:465 con TLS implícito.
EMAIL_SERVICE=gmail

# Informativos: mail.js NO los lee. Se dejan documentados porque el preset ya
# resuelve a estos valores, y para que nadie ponga smtp-relay.gmail.com creyendo
# que se usa: ese relay exige Google Workspace con la IP de salida registrada y
# rechaza las cuentas Gmail normales con 550-5.7.0 "Mail relay denied".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

EMAIL_USER=
EMAIL_PASS=
EMAIL_RECEIVER=

# --- Formulario de contacto ----------------------------------------------
# Límite por IP. Por defecto 5 peticiones cada 15 minutos.
CONTACT_MAX_REQUESTS=5
CONTACT_WINDOW_MINUTES=15

# Solo diagnóstico. En true acepta cualquier certificado SMTP.
# Nunca en producción.
# SMTP_INSECURE_TLS=false
