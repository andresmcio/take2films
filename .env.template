# SMTP. host/port are authoritative: do not reintroduce an EMAIL_SERVICE
# variable, because nodemailer's service presets silently override them.
SMTP_HOST=
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_RECEIVER=

# Contact form rate limit (per IP). Defaults: 5 requests per 15 minutes.
CONTACT_MAX_REQUESTS=5
CONTACT_WINDOW_MINUTES=15

# Diagnostics only. Setting this to true accepts any SMTP certificate and
# must never be used in production.
# SMTP_INSECURE_TLS=false
